<?xml version="1.0"?>
<!--
  piper_description.urdf.xacro
  ==========================
  두 Piper 로봇 팔의 진입점 Xacro 파일입니다.
  좌우 팔의 말단장치를 각각 선택합니다.

  파라미터:
    left_end_effector : none | gripper | revo2 | pika (왼쪽 arm)
    right_end_effector: none | gripper | revo2 | pika (오른쪽 arm)
    left_with_camera : true | false (기본값: false)
    right_with_camera: true | false (기본값: false)
                      해당 arm의 gripper_base에 카메라 스탠드와 D435를 로드합니다.

  사용 예시(명령줄에서 직접 파싱):
    xacro piper_description.urdf.xacro left_end_effector:=gripper right_end_effector:=pika
    xacro piper_description.urdf.xacro left_end_effector:=gripper left_with_camera:=true
    xacro piper_description.urdf.xacro left_end_effector:=gripper right_end_effector:=gripper left_with_camera:=true right_with_camera:=true
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper">

  <!-- ================================================================
       파라미터 선언
       ================================================================ -->
  <xacro:arg name="left_end_effector" default="none"/>
  <xacro:arg name="right_end_effector" default="none"/>
  <!-- 두 arm base_link 사이의 Y축 간격(m) -->
  <xacro:arg name="arm_spacing"       default="0.60"/>
  <xacro:arg name="left_with_camera"  default="false"/>
  <xacro:arg name="right_with_camera" default="false"/>

  <!-- 조건식 평가를 위해 인자를 xacro 속성으로 변환합니다. -->
  <xacro:property name="left_ee"        value="$(arg left_end_effector)"/>
  <xacro:property name="right_ee"       value="$(arg right_end_effector)"/>
  <xacro:property name="arm_spacing"    value="$(arg arm_spacing)"/>

  <xacro:property name="urdf_root" value="$(find piper_arm_description)/urdf"/>
  <xacro:include filename="${urdf_root}/piper/piper_description.urdf"/>
  <xacro:include filename="${urdf_root}/gripper.urdf"/>
  <xacro:include filename="${urdf_root}/pika2_gripper.urdf"/>

  <!-- Revo2 hand files contain fixed left_/right_ frame names.  This macro
       supplies the arm-specific flange that joins a selected hand to a Piper. -->
  <xacro:macro name="revo2_mount" params="prefix parent hand_base">
    <link name="${prefix}flange_link">
      <visual>
        <geometry><mesh filename="package://piper_arm_description/meshes/piper/dae/flange.dae"/></geometry>
      </visual>
      <collision>
        <geometry><mesh filename="package://piper_arm_description/meshes/piper/flange.stl"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}flange_joint" type="fixed">
      <parent link="${parent}"/><child link="${prefix}flange_link"/>
    </joint>
    <joint name="${prefix}hand_base_joint" type="fixed">
      <origin xyz="0 0 0.008" rpy="0 0 0"/>
      <parent link="${prefix}flange_link"/><child link="${hand_base}"/>
    </joint>
  </xacro:macro>

  <!-- End effectors are independently selected for each arm.  Revo2 uses a
       left-hand model on the left arm and a right-hand model on the right. -->
    <link name="world"/>
    <xacro:piper_arm prefix="left_arm_" parent="world" xyz="0 ${float(arm_spacing) / 2.0} 0" rpy="0 0 0"/>
    <xacro:piper_arm prefix="right_arm_" parent="world" xyz="0 ${-float(arm_spacing) / 2.0} 0" rpy="0 0 0"/>

    <xacro:if value="${left_ee == 'gripper'}">
      <xacro:piper_gripper prefix="left_" parent="left_arm_link6"/>
    </xacro:if>
    <xacro:if value="${right_ee == 'gripper'}">
      <xacro:piper_gripper prefix="right_" parent="right_arm_link6"/>
    </xacro:if>

    <xacro:if value="${left_ee == 'pika'}">
      <xacro:pika_gripper prefix="left_" parent="left_arm_link6"/>
    </xacro:if>
    <xacro:if value="${right_ee == 'pika'}">
      <xacro:pika_gripper prefix="right_" parent="right_arm_link6"/>
    </xacro:if>

    <xacro:if value="${left_ee == 'revo2'}">
      <xacro:include filename="${urdf_root}/revo2/revo2_left_hand.urdf"/>
      <xacro:revo2_mount prefix="left_" parent="left_arm_link6" hand_base="left_base_link"/>
    </xacro:if>
    <xacro:if value="${right_ee == 'revo2'}">
      <xacro:include filename="${urdf_root}/revo2/revo2_right_hand.urdf"/>
      <xacro:revo2_mount prefix="right_" parent="right_arm_link6" hand_base="right_base_link"/>
    </xacro:if>

  <!-- 두 카메라가 공유하는 재질과 센서 매크로는 한 번만 포함합니다. -->
  <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro"/>

  <!-- 각 gripper_base에 스탠드와 D435를 장착합니다. 왼쪽 링크 이름은 유지합니다. -->
  <xacro:macro name="gripper_camera" params="prefix parent">
      <link name="${prefix}camera_stand_link">
        <inertial>
          <origin rpy="0 0 0" xyz="0 0 0"/>
          <mass value="0.2"/>
          <inertia ixx="0.0002" ixy="0.0" ixz="0.0"
                   iyy="0.0002" iyz="0.0"
                   izz="0.0001"/>
        </inertial>
        <visual>
          <origin rpy="-1.57 0 1.57" xyz="0 0 0"/>
          <geometry>
            <mesh filename="package://piper_arm_description/meshes/realsense_mid_stand.dae"/>
          </geometry>
        </visual>
        <collision>
          <origin rpy="0 0 0" xyz="0 0 0"/>
          <geometry>
            <mesh filename="package://piper_arm_description/meshes/realsense_mid_stand.dae"/>
          </geometry>
        </collision>
      </link>

      <joint name="${prefix}camera_stand_joint" type="fixed">
        <origin xyz="-0.034 -0.001 0.022" rpy="0.0 0.0 0.0"/>
        <parent link="${parent}"/>
        <child link="${prefix}camera_stand_link"/>
      </joint>

      <link name="${prefix}d435_camera_link"/>
      <joint name="${prefix}d435_camera_joint" type="fixed">
        <origin xyz="-0.031 -0.028 0.0018" rpy="0.0 -1.22 0.0"/>
        <parent link="${prefix}camera_stand_link"/>
        <child link="${prefix}d435_camera_link"/>
      </joint>
      <xacro:sensor_d435 parent="${prefix}d435_camera_link" name="${prefix}camera">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:sensor_d435>
  </xacro:macro>

  <!-- xacro:if가 문자열 인자를 boolean으로 파싱합니다. -->
  <xacro:if value="$(arg left_with_camera)">
    <xacro:if value="${left_ee == 'gripper'}">
      <xacro:gripper_camera prefix="" parent="left_gripper_base"/>
    </xacro:if>
  </xacro:if>
  <xacro:if value="$(arg right_with_camera)">
    <xacro:if value="${right_ee == 'gripper'}">
      <xacro:gripper_camera prefix="right_" parent="right_gripper_base"/>
    </xacro:if>
  </xacro:if>

</robot>
