<sdf version='1.11'>
  <model name='N1-Robot'>
    <!-- Publish this model's movable joint positions on Gazebo Transport. -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
    </plugin>
    <!-- Four-wheel skid-steer drive, commanded through /cmd_vel. -->
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>lwheel1_Joint</left_joint>
      <left_joint>lwheel2_Joint</left_joint>
      <right_joint>rwheel1_Joint</right_joint>
      <right_joint>rwheel2_Joint</right_joint>
      <wheel_separation>0.1955</wheel_separation>
      <wheel_radius>0.04</wheel_radius>
      <max_linear_velocity>0.3</max_linear_velocity>
      <min_linear_velocity>-0.3</min_linear_velocity>
      <max_angular_velocity>1.0</max_angular_velocity>
      <min_angular_velocity>-1.0</min_angular_velocity>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <tf_topic>/tf</tf_topic>
    </plugin>
    <!-- Arm position commands are expressed in radians on /armN/cmd_pos. -->
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>arm1_Joint</joint_name>
      <topic>/arm1/cmd_pos</topic>
      <initial_position>0.0</initial_position>
      <p_gain>10</p_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>arm2_Joint</joint_name>
      <topic>/arm2/cmd_pos</topic>
      <initial_position>1.20</initial_position>
      <p_gain>10</p_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>arm3_Joint</joint_name>
      <topic>/arm3/cmd_pos</topic>
      <initial_position>-1.45</initial_position>
      <p_gain>10</p_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>arm4_Joiint</joint_name>
      <topic>/arm4/cmd_pos</topic>
      <initial_position>-1.32</initial_position>
      <p_gain>10</p_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>arm5_Joint</joint_name>
      <topic>/arm5/cmd_pos</topic>
      <initial_position>0.0</initial_position>
      <p_gain>10</p_gain>
    </plugin>
    <!-- The ROS gripper command router sends signed targets to these joints. -->
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>llink1_Joint</joint_name>
      <topic>/gripper/llink1/cmd_pos</topic>
      <initial_position>0</initial_position>
      <p_gain>1</p_gain>
      <d_gain>0.1</d_gain>
      <use_velocity_commands>true</use_velocity_commands>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>llink2_Joint</joint_name>
      <topic>/gripper/llink2/cmd_pos</topic>
      <initial_position>0</initial_position>
      <p_gain>1</p_gain>
      <d_gain>0.1</d_gain>
      <use_velocity_commands>true</use_velocity_commands>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>llink3_Joint</joint_name>
      <topic>/gripper/llink3/cmd_pos</topic>
      <initial_position>0</initial_position>
      <p_gain>1</p_gain>
      <d_gain>0.1</d_gain>
      <use_velocity_commands>true</use_velocity_commands>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>rlink1_Joint</joint_name>
      <topic>/gripper/rlink1/cmd_pos</topic>
      <initial_position>0</initial_position>
      <p_gain>1</p_gain>
